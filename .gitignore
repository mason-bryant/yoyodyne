
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Local Go build output
/yoyodyne
# Release archives written by "make dist"
/dist/
# Ignore build output inside bin/, but not the directory itself: git cannot
# re-include a file when its parent directory is excluded.
/bin/*
!/bin/yoyo-status
