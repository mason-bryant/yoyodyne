
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Local Go build output
/yoyodyne
# Release archives written by "make dist"
/dist/
# Ignore build output inside bin/, but not the directory itself: git cannot
# re-include a file when its parent directory is excluded. Every script that
# belongs in the repository needs its own line here, because the exclusion above
# is what a new one silently falls into: the file is on disk, the documentation
# tells an operator to run it, and nothing ever committed it.
/bin/*
!/bin/yoyo-status
!/bin/yoyo-account

# bd's atomic-write temp files: an export mid-write must never read as a dirty
# checkout (two reviewed rounds died on this race in one afternoon, 2026-09-05)
.beads/.~*
