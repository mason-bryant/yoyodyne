#!/usr/bin/env bash
#
# yoyo-status - retired. `yoyo status` is the status surface; this delegates to it.
#
# This script used to read the state directory itself and derive run,
# conversation, branch-review, and exchange state out of it in shell, beside the
# binary that derives the same things from the shared read model. The architect
# ruled that it is an operator surface like any other and so is bound by
# surfaces-project-one-read-model, which forbids a second surface computing what
# the model already computes. So the derivations are gone and the name is kept:
# an operator who still types the old name lands on the surface that answers now.
#
# What the retired modes are answered by:
#
#   yoyo status    where the harness stands, and what became of the runs -- one
#                  still in flight included, with its phase, elapsed time, and
#                  what it has spent so far
#   yoyo cost      what a work item cost, and what the roles spent asking each
#                  other
#
# Two things this had that nothing has now: following an event stream live, and
# pricing conversations and branch reviews. Both were to be folded into the
# binary by yoyodyne-ifd.63, which is blocked rather than landed.

set -euo pipefail

# The flags this script took and `yoyo status` does not. An operator who still
# types one of them is told where that capability went, rather than getting an
# unknown-flag error from a verb that never had the flag.
for argument in "$@"; do
  case "$argument" in
    -l|--list|-c|--cost|-L|--follow-latest|-n|--lines|--runs|--chats|--conversations|--reviews|--branch-reviews|--raw|--all|--no-follow|--product)
      echo "yoyo-status is retired: $argument was one of its own flags, and yoyo status does not take it." >&2
      echo "  what became of the runs, one still in flight included:  yoyo status" >&2
      echo "  what the work cost:                                     yoyo cost" >&2
      echo "  following an event stream live:                         nothing does it now (yoyodyne-ifd.63)" >&2
      exit 2
      ;;
  esac
done

command -v yoyo >/dev/null 2>&1 || {
  echo "yoyo is not on PATH, and this is a wrapper for \`yoyo status\` now." >&2
  echo "install it with \"go install github.com/mason-bryant/yoyodyne/cmd/yoyo@latest\", or run ./bin/yoyo status from a build of this checkout." >&2
  exit 1
}

exec yoyo status "$@"
