#!/usr/bin/env bash
#
# yoyo-status - follow the event stream of a Yoyodyne run or conversation.
#
# A conversation and a branch review are each recorded beside runs rather than
# among them, but it is the same question being asked of all three - is this
# alive, what is it doing, and what did it cost - so every mode here covers all
# of them and the default never asks which kind you meant.
# An inter-role exchange is recorded beside all three and has no event stream to
# follow, so it appears in the cost report and nowhere else: what two roles spent
# asking each other is money the harness spent, and a total without it is short.
# The state directory is resolved the same way the harness resolves it, so this
# keeps working when YOYODYNE_STATE_HOME or XDG_STATE_HOME is set, and on Linux
# and Windows checkouts as well as macOS.
#
#   yoyo-status                  follow the newest run or conversation
#   yoyo-status -L               follow the newest, and switch when a later one starts
#   yoyo-status 40b68275         follow one by id or unique id prefix
#   yoyo-status -l               list recent runs and conversations and exit
#   yoyo-status -c               report the last 7 days of spend, by day and in total
#   yoyo-status -c 30            report that many days instead of 7
#   yoyo-status -c 40b68275      report spend for one run, conversation, or exchange, any day
#   yoyo-status -n 200           replay the last 200 events before following
#   yoyo-status --runs           runs only
#   yoyo-status --chats          conversations only
#   yoyo-status --reviews        branch reviews only
#   yoyo-status --all            include thinking-token noise
#   yoyo-status --raw            emit raw JSONL, no jq shaping
#   yoyo-status --no-follow      print and exit instead of following

set -euo pipefail

# Print the header comment block, stopping at the first line that is not a
# comment, so the usage text cannot drift out of sync with the file.
usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$0"; }

product=""
run_arg=""
lines=50
follow=1
follow_latest=0
list_only=0
cost_only=0
# How many local-timezone days a cost report covers when nobody says. A week is
# what an operator budgets against, and a report that reached back over every
# run the machine has ever done would bury the days they are actually deciding
# about under months of settled ones.
cost_days=7
raw=0
include_all=0
want_runs=1
want_chats=1
want_reviews=1
# Exchanges are priced by default and never followed, so narrowing to any one of
# the followable kinds narrows them out too: somebody who asked for runs alone is
# asking what the runs cost.
want_exchanges=1

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -l|--list) list_only=1; shift ;;
    -c|--cost) cost_only=1; shift ;;
    -L|--follow-latest) follow_latest=1; shift ;;
    -n|--lines) lines="${2:?-n needs a value}"; shift 2 ;;
    --runs) want_chats=0; want_reviews=0; want_exchanges=0; shift ;;
    --chats|--conversations) want_runs=0; want_reviews=0; want_exchanges=0; shift ;;
    --reviews|--branch-reviews) want_runs=0; want_chats=0; want_exchanges=0; shift ;;
    --raw) raw=1; shift ;;
    --all) include_all=1; shift ;;
    --no-follow) follow=0; shift ;;
    --product) product="${2:?--product needs a value}"; shift 2 ;;
    --) shift; break ;;
    -*) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
    *) run_arg="$1"; shift ;;
  esac
done

# Mirror runstate.SystemDefaultRoot so this agrees with the harness.
state_root() {
  if [ -n "${YOYODYNE_STATE_HOME:-}" ]; then printf '%s\n' "$YOYODYNE_STATE_HOME"; return; fi
  if [ -n "${XDG_STATE_HOME:-}" ]; then printf '%s\n' "$XDG_STATE_HOME/yoyodyne"; return; fi
  case "$(uname -s)" in
    Darwin) printf '%s\n' "$HOME/Library/Application Support/Yoyodyne/state" ;;
    MINGW*|MSYS*|CYGWIN*) printf '%s\n' "${LOCALAPPDATA:-$HOME/AppData/Local}/Yoyodyne/state" ;;
    *) printf '%s\n' "$HOME/.local/state/yoyodyne" ;;
  esac
}

root="$(state_root)"

# Whether the operator has paused all harness activity, which is the first thing
# to say about a machine that looks idle: a system somebody paused and forgot
# looks exactly like a system that died, and only one of those needs anybody.
# The hold sits at the state root rather than under a product because it is one
# switch over the whole machine, and it is pretty-printed one key per line, so
# reading it needs no jq.
announce_operator_hold() {
  local hold="$root/operator-hold.json" since
  [ -f "$hold" ] || return 0
  # Fractional seconds are dropped for the same reason a listed start time drops
  # them: nobody reads a pause to the microsecond.
  since="$(sed -n 's/^[[:space:]]*"held_at":[[:space:]]*"\([^"]*\)".*/\1/p' "$hold" | head -1 | sed 's/\.[0-9]*Z$/Z/')"
  echo "PAUSED: all harness activity is paused${since:+ since $since}" >&2
  echo "nothing reaches the provider until \`yoyo resume\` lifts it; parked runs keep their claim, branch, and worktree" >&2
}
announce_operator_hold

products="$root/products"
[ -d "$products" ] || { echo "no Yoyodyne state at $products" >&2; exit 1; }

# Prefer an explicit product, then the one this checkout configures, then the
# only one present. Guessing between several would tail the wrong project.
if [ -z "$product" ]; then
  if [ -f .yoyodyne/config.yaml ]; then
    product="$(sed -n 's/^[[:space:]]*id:[[:space:]]*//p' .yoyodyne/config.yaml | head -1)"
  fi
fi
if [ -z "$product" ] || [ ! -d "$products/$product" ]; then
  count=$(find "$products" -mindepth 1 -maxdepth 1 -type d | wc -l | tr -d ' ')
  if [ "$count" = "1" ]; then
    product="$(basename "$(find "$products" -mindepth 1 -maxdepth 1 -type d)")"
  else
    echo "specify --product; found $count under $products:" >&2
    find "$products" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; >&2
    exit 1
  fi
fi

# Whether the operator has held what the harness starts on its own. It is the
# quieter of the two switches and it is announced after the product is resolved
# rather than with the pause, because unlike the pause it belongs to one backlog.
# A machine with runs finishing and nothing new beginning looks like a machine
# that ran out of work, and only this says otherwise.
announce_intake_hold() {
  local hold="$products/$product/intake-hold.json" since reason
  [ -f "$hold" ] || return 0
  since="$(sed -n 's/^[[:space:]]*"held_at":[[:space:]]*"\([^"]*\)".*/\1/p' "$hold" | head -1 | sed 's/\.[0-9]*Z$/Z/')"
  reason="$(sed -n 's/^[[:space:]]*"reason":[[:space:]]*"\(.*\)".*/\1/p' "$hold" | head -1)"
  echo "INTAKE HELD: the harness starts nothing more on its own${since:+ since $since}" >&2
  [ -n "$reason" ] && echo "$reason" >&2
  # The remedy is named as something runnable from the terminal this was read
  # at. `/release` in a conversation lifts the same record, but a person reading
  # a status listing may have no conversation open, and a remedy they cannot run
  # from where they are standing is not one.
  echo "work already running carries on; \`yoyo release\` lets it choose work again, as does /release in a conversation" >&2
}
announce_intake_hold

runs="$products/$product/runs"
conversations="$products/$product/conversations"
reviews="$products/$product/branch-reviews"
exchanges="$products/$product/exchanges"

# A product that has only ever chatted has no runs directory, one that has only
# ever run has no conversations directory, one whose branches have never been
# reviewed has no branch-reviews directory, and one whose roles have never asked
# each other anything has no exchanges directory. Any one on its own is enough to
# work with, so only having none of the selected kinds is a refusal.
have_kind() {
  case "$1" in
    runs) [ "$want_runs" = "1" ] && [ -d "$runs" ] ;;
    chats) [ "$want_chats" = "1" ] && [ -d "$conversations" ] ;;
    reviews) [ "$want_reviews" = "1" ] && [ -d "$reviews" ] ;;
    exchanges) [ "$want_exchanges" = "1" ] && [ -d "$exchanges" ] ;;
  esac
}
if ! have_kind runs && ! have_kind chats && ! have_kind reviews && ! have_kind exchanges; then
  echo "no runs, conversations, branch reviews, or exchanges under $products/$product" >&2
  exit 1
fi

# Every event log of the selected kinds, newest first, optionally narrowed to
# the ones whose id contains a pattern. The globs are passed as separate
# arguments so a state directory whose path contains spaces survives, and an
# unmatched glob simply contributes nothing.
event_logs() {
  local pattern="${1:-}" order="${2:--t}"
  set --
  if have_kind runs; then set -- "$@" "$runs"/*"$pattern"*.events.jsonl; fi
  if have_kind chats; then set -- "$@" "$conversations"/*"$pattern"*.events.jsonl; fi
  if have_kind reviews; then set -- "$@" "$reviews"/*"$pattern"*.events.jsonl; fi
  [ $# -gt 0 ] || return 0
  ls "$order" "$@" 2>/dev/null || true
}

newest() { event_logs | head -1; }

# Every recorded exchange, narrowed the way the event logs are. An exchange is
# one revised record rather than a stream of events, so it is never followed and
# never listed beside the three kinds that are: it is here for the cost report,
# which is the one question it can answer.
exchange_records() {
  local pattern="${1:-}" order="${2:--t}"
  have_kind exchanges || return 0
  set -- "$exchanges"/*"$pattern"*.json
  ls "$order" "$@" 2>/dev/null || true
}

# What an exchange is, in the one word `yoyo exchange` says it in: open while it
# is still being conducted, and otherwise how it ended.
exchange_state() {
  jq -r 'if ((.outcome // "") == "") then "open" else .outcome end' "$1" 2>/dev/null || echo "?"
}

# The exchange records the report could not read, named rather than dropped. A
# record nobody can parse did not cost nothing, so it is counted, the exchanges
# beside it are priced as usual, and every total it is missing from is said to be
# a floor. `yoyo cost` answers the same way for the same records -- it counts
# them in its ask row's unpriced column, prices the rest, and marks its own total
# -- because two surfaces differing about what an unknown figure is leaves the
# operator to settle it.
report_unreadable_exchanges() {
  local list="$1"
  [ -s "$list" ] || return 0
  printf '%s exchange record(s) could not be read; they are left out rather than counted as nothing, so any total here is a floor:\n' \
    "$(wc -l < "$list" | tr -d ' ')"
  sed 's/^/  /' "$list"
}

# The three kinds are told apart by their id, which is the same thing their
# records are named for.
kind_of() {
  case "$(basename "$1")" in
    chat-*) echo conversation ;;
    review-*) echo review ;;
    *) echo run ;;
  esac
}

# A conversation has no state file of its own. The role's record names the
# conversation that role is in now, so every other log in the directory belonged
# to one that has since been replaced. Loaded once: a listing asks for this on
# every row.
current_conversation_ids=""
current_conversation_ids_loaded=0
load_current_conversation_ids() {
  if [ "$current_conversation_ids_loaded" = "1" ]; then return 0; fi
  current_conversation_ids_loaded=1
  if [ ! -d "$conversations" ]; then return 0; fi
  local file id
  for file in "$conversations"/*.json; do
    [ -f "$file" ] || continue
    # The record is pretty-printed one key per line and conversation_id appears
    # once, unnested, so this needs no jq and a listing stays useful without it.
    id="$(sed -n 's/^[[:space:]]*"conversation_id":[[:space:]]*"\([^"]*\)".*/\1/p' "$file" | head -1)"
    if [ -n "$id" ]; then current_conversation_ids="$current_conversation_ids $id"; fi
  done
  return 0
}

# What a conversation is doing, which is what "is this alive" is asking: an
# agent is answering it, it is between turns and waiting for you, or it has been
# replaced and nothing will happen in it again.
conversation_status() {
  local id turn
  id="$(basename "$1" .events.jsonl)"
  load_current_conversation_ids
  case " $current_conversation_ids " in
    *" $id "*) ;;
    *) echo "ended"; return ;;
  esac
  # Each turn is a provider invocation and is bracketed by the same two events a
  # run's are, so a conversation whose last one is a start is still being
  # answered. A quote inside a payload is escaped, so no payload text can match
  # this and it needs no jq either.
  turn="$(grep -oE '"type":"run\.(started|completed)"' "$1" 2>/dev/null | tail -1 || true)"
  case "$turn" in
    *started*) echo "answering" ;;
    *) echo "waiting" ;;
  esac
}

# A branch review has no state file: the verdict log is one shared file rather
# than one record per review, so what a review is doing is read from its own
# event stream. A completed review has emitted its verdict event; anything else
# is still being made.
review_status() {
  if grep -q '"type":"review.completed"' "$1" 2>/dev/null; then echo "reviewed"; else echo "reviewing"; fi
}

# The state file is pretty-printed and has nested "status" keys, so match the
# top-level one by its indent rather than the first occurrence anywhere.
status_of() {
  if [ "$(kind_of "$1")" = "conversation" ]; then conversation_status "$1"; return; fi
  if [ "$(kind_of "$1")" = "review" ]; then review_status "$1"; return; fi
  local state="${1%.events.jsonl}.json"
  [ -f "$state" ] || { echo "?"; return; }
  if command -v jq >/dev/null 2>&1; then
    jq -r '.status // "?"' "$state" 2>/dev/null || echo "?"
  else
    sed -n 's/^  "status":[[:space:]]*"\([a-z_]*\)".*/\1/p' "$state" | head -1
  fi
}

# When it started, as the three things a cost report asks of that moment: the
# epoch second it began, the local day it belongs to, and the local time to the
# minute as a row displays it. A run records the moment in its state file; a
# conversation's and a branch review's is the timestamp of their first event,
# which is the same moment and needs no state file to find. All three come from
# one jq invocation because the report asks this of every row.
#
# This is what a row says in its "started" column on the day the work opened on.
# It is not what decides the day money counts against -- an invocation counts on
# the day it was made, which for a long-lived conversation is not the day the
# conversation began.
started_fields_of() {
  local stamp="" state
  if [ "$(kind_of "$1")" != "run" ]; then
    stamp="$(head -1 "$1" 2>/dev/null | jq -r '.timestamp // empty' 2>/dev/null || true)"
  else
    state="${1%.events.jsonl}.json"
    if [ -f "$state" ]; then
      stamp="$(jq -r '.started_at // empty' "$state" 2>/dev/null || true)"
    fi
  fi
  # Something whose moment cannot be read still cost money, so it is reported
  # rather than dropped: it groups under "undated", ahead of every dated day,
  # and no window excludes it, because it has no day to be outside of.
  [ -n "$stamp" ] || { printf '0\tundated\t-\n'; return; }
  # The stored timestamp is UTC with fractional seconds, which fromdateiso8601
  # will not parse, so drop them first.
  jq -rn --arg stamp "$stamp" '$stamp
         | sub("\\.[0-9]+";"")
         | fromdateiso8601
         | [ tostring, strflocaltime("%Y-%m-%d"), strflocaltime("%m %d %Y %H:%M") ]
         | @tsv' 2>/dev/null || printf '0\tundated\t-\n'
}

# Today, in the timezone the operator's day happens in.
today_local() { jq -rn 'now | floor | strflocaltime("%Y-%m-%d")'; }

# The oldest local day a report of $1 days covers, today counting as the first
# of them, so 7 is today and the six before it. The arithmetic is anchored at
# local noon rather than at the current moment, so a daylight-saving shift can
# move the answer by an hour without ever moving it by a day.
oldest_day() {
  jq -rn --argjson days "$1" '
    (now | floor) as $moment
    | ($moment | strflocaltime("%H %M %S") | split(" ") | map(tonumber)) as $clock
    | ($moment - ($clock[0] * 3600 + $clock[1] * 60 + $clock[2]) + 43200) as $noon
    | ($noon - ($days - 1) * 86400) | strflocaltime("%Y-%m-%d")'
}

if [ "$list_only" = "1" ]; then
  event_logs | head -20 | while read -r f; do
    b="$(basename "$f" .events.jsonl)"
    printf '%-40s %-10s %s events\n' "$b" "$(status_of "$f")" "$(wc -l < "$f" | tr -d ' ')"
  done
  exit 0
fi

# Every provider invocation ends in a run.completed event carrying that
# invocation's usage and cost. For a run that is the sum over its agents: a
# developer, plus a reviewer once automatic integration is enabled, plus one
# more per repair attempt. For a conversation it is the sum over its turns,
# which are provider invocations like any other and are recorded the same way,
# so leaving them out understated every total they belonged in. An inter-role
# exchange is the same argument once more: the answering half of each round is an
# invocation the harness made, recorded in the exchange rather than in an event
# log, and a total that read only the logs was short by exactly what the roles
# spent asking each other. Cost is what the provider reported, not an estimate.
#
# The rows are grouped by the local-timezone day the money was spent on and each
# group closes with that day's spend, because "what did today cost" is the axis
# an operator budgets on and the day it asks about is the one their own clock
# is keeping. Today's group is last, where the eye already is.
#
# What counts on a day is each invocation, not the log it was recorded in: a
# conversation stays open for as long as the role is in it, so a chat opened a
# fortnight ago and answered again this morning spends on both days, and one
# row for the day it opened would leave this morning out of what today cost.
# A log that spans days therefore contributes one row to each day it spent on.
cost_report() {
  command -v jq >/dev/null 2>&1 || { echo "cost reporting needs jq" >&2; exit 1; }
  local pattern="${1:-}" days="${2:-}" files asks
  files=$(event_logs "$pattern" -tr)
  asks=$(exchange_records "$pattern" -tr)
  [ -n "$files$asks" ] || { echo "no runs, conversations, branch reviews, or exchanges found" >&2; exit 1; }

  local today oldest=""
  today="$(today_local)"
  [ -z "$days" ] || oldest="$(oldest_day "$days")"

  # Aggregate per run at full precision first. Totalling the displayed values
  # instead would accumulate the rounding error from each row.
  # An explicit template, because macOS mktemp ignores TMPDIR without one and
  # falls back to a per-user directory a restricted environment can deny.
  local tmp unreadable
  tmp="$(mktemp "${TMPDIR:-/tmp}/yoyo-status.XXXXXX")"
  # Exchange records that could not be read are collected apart from the rows,
  # so what they cost can be reported as missing rather than being absent
  # without anybody being told.
  unreadable="$(mktemp "${TMPDIR:-/tmp}/yoyo-status.XXXXXX")"
  trap 'rm -f "$tmp" "$unreadable"' RETURN
  # Every selected log is read, whatever day it opened on, because the window is
  # about when the money was spent and a log that opened before it can still
  # have spent inside it. Only the rows a log yields are held against the
  # window, which is what keeps this morning's turn of a fortnight-old
  # conversation in this morning's total.
  printf '%s\n' "$files" | while read -r f; do
    [ -n "$f" ] || continue
    local start_epoch start_day start_ts
    IFS=$'\t' read -r start_epoch start_day start_ts <<<"$(started_fields_of "$f")"
    jq -r 'select(.type=="run.completed")
           | ((.timestamp // "") | sub("\\.[0-9]+";"") | try fromdateiso8601 catch null) as $moment
           | [ (if $moment == null then "undated" else ($moment | strflocaltime("%Y-%m-%d")) end),
               ($moment // 0),
               (if $moment == null then "-" else ($moment | strflocaltime("%m %d %Y %H:%M")) end),
               (.payload.total_cost_usd // 0),
               (.payload.usage.input_tokens // 0),
               (.payload.usage.output_tokens // 0),
               (.payload.usage.cache_creation_input_tokens // 0),
               (.payload.usage.cache_read_input_tokens // 0) ]
           | @tsv' "$f" 2>/dev/null \
    | awk -F'\t' -v id="$(basename "$f" .events.jsonl)" -v st="$(status_of "$f")" -v oldest="$oldest" \
          -v start_day="$start_day" -v start_epoch="$start_epoch" -v start_ts="$start_ts" '
        # Events arrive in the order they were recorded, so the first one seen
        # for a day is the earliest that day.
        { day=$1;
          if (!(day in n)) { order[++days]=day; first_epoch[day]=$2; first_ts[day]=$3 }
          n[day]++; cost[day]+=$4; in_[day]+=$5; out[day]+=$6; cw[day]+=$7; cr[day]+=$8 }
        END {
          for (i = 1; i <= days; i++) {
            day=order[i];
            if (oldest != "" && day != "undated" && day < oldest) continue;
            # The day the work opened on says when it opened, which is what the
            # column has always said; a later day says when it next spent,
            # because on that day there is nothing else the column could mean.
            epoch = (day == start_day ? start_epoch : first_epoch[day]);
            ts    = (day == start_day ? start_ts    : first_ts[day]);
            printf "%s\t%s\t%s\t%s\t%d\t%d\t%d\t%d\t%d\t%.10f\t%s\n",
                   day, epoch, id, ts, n[day], in_[day], out[day], cw[day], cr[day], cost[day], st;
          }
        }'
  done > "$tmp"

  # An exchange is not an event log. It is one record per thread, revised as it
  # goes, and each round in it is a provider invocation the harness made to carry
  # one role's question to another. The money is recorded per round beside the
  # moment the answer came in, so a round counts on the day it was answered
  # exactly as an invocation counts on the day it was made, and a thread that ran
  # over two days contributes a row to each of them as a conversation does.
  #
  # What the record does not keep is the provider's token usage, so those columns
  # are "-" rather than 0: an exchange did not use no tokens, and a zero there
  # would be added into a day's token total as though it had.
  printf '%s\n' "$asks" | while read -r f; do
    [ -n "$f" ] || continue
    local rows
    # A record that cannot be read costs the report that one exchange rather
    # than the whole report -- and it is counted on the way past rather than
    # dropped, because an exchange nobody can parse did not cost nothing, and a
    # total short by a thread nobody was told about is the mistake the whole
    # unknown-never-zero discipline exists to stop.
    if ! rows="$(jq -r '(.rounds // [])[]
             | ((.answered_at // .asked_at // "") | sub("\\.[0-9]+";"") | try fromdateiso8601 catch null) as $moment
             | [ (if $moment == null then "undated" else ($moment | strflocaltime("%Y-%m-%d")) end),
                 ($moment // 0),
                 (if $moment == null then "-" else ($moment | strflocaltime("%m %d %Y %H:%M")) end),
                 (.cost_usd // 0) ]
             | @tsv' "$f" 2>/dev/null)"; then
      basename "$f" .json >> "$unreadable"
      continue
    fi
    # An exchange opened and not yet answered has rounds but no spending, and a
    # blank line put through the row builder would become a row for a day named
    # nothing.
    [ -n "$rows" ] || continue
    printf '%s\n' "$rows" \
    | awk -F'\t' -v id="$(basename "$f" .json)" -v st="$(exchange_state "$f")" -v oldest="$oldest" '
        { day=$1;
          if (!(day in n)) { order[++days]=day; first_epoch[day]=$2; first_ts[day]=$3 }
          n[day]++; cost[day]+=$4 }
        END {
          for (i = 1; i <= days; i++) {
            day=order[i];
            if (oldest != "" && day != "undated" && day < oldest) continue;
            printf "%s\t%s\t%s\t%s\t%d\t%s\t%s\t%s\t%s\t%.10f\t%s\n",
                   day, first_epoch[day], id, first_ts[day], n[day], "-", "-", "-", "-", cost[day], st;
          }
        }'
  done >> "$tmp"

  # An empty report says which of the three empties it is: every exchange there
  # was could not be read, nothing has been spent at all, or nothing was spent
  # in the days asked about, which a wider window would answer differently.
  if [ ! -s "$tmp" ]; then
    if [ -s "$unreadable" ]; then
      report_unreadable_exchanges "$unreadable"
    elif [ -n "$oldest" ]; then
      echo "no completed provider invocations since $oldest; pass a number of days to reach further back"
    else
      echo "no completed provider invocations yet"
    fi
    return 0
  fi

  # A total that is missing an exchange nobody could read is a lower bound, and
  # is marked the way every other floor in this project is marked.
  local mark=""
  [ ! -s "$unreadable" ] || mark="≥ "

  # The id column is as wide as the widest id there is, which is an exchange's:
  # a column sized to a run's id would be shoved two characters right by every
  # exchange row and take the rest of the table with it.
  printf '%-41s %-17s %6s %8s %9s %10s %11s %9s  %s\n' id started calls in out cache_w cache_r USD status
  # Ordered by when the work started rather than by when its log was last
  # written, which is what makes a day's rows contiguous and puts today last.
  sort -t$'\t' -k2,2n -k3,3 "$tmp" | awk -F'\t' -v today="$today" '
    function close_day() {
      if (day == "") return;
      printf "%-41s %-17s %6d %8d %9d %10d %11d %9.2f\n", day " total", "", dn, din, dout, dcw, dcr, dcost;
      print "";
    }
    $1 != day {
      close_day();
      day=$1; dn=din=dout=dcw=dcr=dcost=0;
      printf "%s%s\n", day, (day==today ? "  (today)" : "");
    }
    # The token columns are printed as they arrived rather than as numbers, so a
    # row that records no usage says "-" where it has nothing to say. Adding it
    # into the day is arithmetic on a string, which is nothing, and that is
    # exactly what it should contribute.
    { printf "%-41s %-17s %6d %8s %9s %10s %11s %9.2f  %s\n", $3,$4,$5,$6,$7,$8,$9,$10,$11;
      dn+=$5; din+=$6; dout+=$7; dcw+=$8; dcr+=$9; dcost+=$10 }
    END { close_day() }'
  awk -F'\t' -v window="${days:+ (last $days days)}" -v mark="$mark" '
    { n+=$5; in_+=$6; out+=$7; cw+=$8; cr+=$9; cost+=$10;
      if ($3 ~ /^chat-/) { chats+=$5; chat_cost+=$10 }
      else if ($3 ~ /^review-/) { revs+=$5; rev_cost+=$10 }
      else if ($3 ~ /^exchange-/) { asks+=$5; ask_cost+=$10 }
      else { plain+=$5; run_cost+=$10 } }
    END {
      print  "------------------------------------------------------------------------------------------------------------------";
      # The mark is empty unless a record could not be read, so a report with
      # everything in front of it prints exactly the figure it always did.
      printf "%-41s %-17s %6d %8d %9d %10d %11d %9s\n", "TOTAL" window, "", n, in_, out, cw, cr, mark sprintf("%.2f", cost);
      t=in_+out+cw+cr;
      money = mark sprintf("$%.2f", cost);
      # An exchange records what the provider charged and not what it used, so a
      # report of nothing but exchanges has money and no tokens. Saying so beats
      # dividing by a total of none of them.
      if (t>0) printf "\ntokens: %'"'"'d total (%.1f%% cache reads)   cost: %s\n", t, (cr*100.0)/t, money
      else     printf "\ncost: %s; no token usage is recorded for what this covers\n", money
      # Split the total only when it is actually mixed, so the one number is
      # never left ambiguous about which kinds of work went into it. A branch
      # review and an inter-role exchange are provider invocations like the
      # others and are priced beside them: a total that skipped either would be
      # wrong rather than unattributed.
      kinds=(chats>0)+(plain>0)+(revs>0)+(asks>0);
      if (kinds>1) {
        line="";
        if (plain>0) line=line sprintf("runs: $%.2f from %d invocation(s)", run_cost, plain);
        if (chats>0) line=line (line==""?"":"   ") sprintf("conversations: $%.2f from %d turn(s)", chat_cost, chats);
        if (revs>0)  line=line (line==""?"":"   ") sprintf("branch reviews: $%.2f from %d invocation(s)", rev_cost, revs);
        if (asks>0)  line=line (line==""?"":"   ") sprintf("exchanges: $%.2f from %d round(s)", ask_cost, asks);
        print line;
      }
      if (asks>0) print "an exchange records what the provider charged and not what it used, so its rows carry no tokens";
    }' "$tmp"
  report_unreadable_exchanges "$unreadable"
}

if [ "$cost_only" = "1" ]; then
  # The one argument the report takes is either a number of days or the thing
  # to price, and a purely numeric one is the count, because an operator asking
  # for a fortnight would not otherwise have a way to say so. An id prefix can
  # be all digits too -- ids are hex -- so one that is must be given with its
  # run-, chat-, review-, or exchange- prefix to be read as an id rather than as
  # days.
  # Naming one prices it whatever day it ran on: the window is for the report
  # that chooses what to show, and an id has already chosen.
  case "$run_arg" in
    ''|*[!0-9]*) ;;
    *)
      # Leading zeros are dropped rather than refused; a count of nothing but
      # them is the one numeric argument there is no report for.
      cost_days="${run_arg#"${run_arg%%[!0]*}"}"
      run_arg=""
      [ -n "$cost_days" ] || { echo "-c needs a positive number of days" >&2; exit 2; }
      ;;
  esac
  if [ -n "$run_arg" ]; then
    cost_report "$run_arg" ""
  else
    cost_report "" "$cost_days"
  fi
  exit 0
fi

if [ -n "$run_arg" ]; then
  # Newest first, so an ambiguous prefix lands on the one most likely meant.
  target="$(event_logs "$run_arg" | head -1)"
  [ -n "$target" ] || { echo "no run, conversation, or branch review matching '$run_arg' under $products/$product" >&2; exit 1; }
else
  target="$(newest)"
  # Nothing yet is normal when a run is about to start, so wait rather than fail.
  while [ -z "$target" ]; do
    echo "waiting for a run or conversation to start under $products/$product ..." >&2
    sleep 2
    target="$(newest)"
  done
fi

shape() {
  if [ "$raw" = "1" ]; then cat; return; fi
  if ! command -v jq >/dev/null 2>&1; then cat; return; fi
  if [ "$include_all" = "1" ]; then
    jq --unbuffered -c '{sequence, timestamp, type, source, payload}'
  else
    # Thinking-token pings carry no payload and drown everything else.
    jq --unbuffered -c 'select(.payload.provider_subtype != "thinking_tokens")
                        | {sequence, timestamp, type, source, payload}'
  fi
}

echo "==> $(basename "$target" .events.jsonl) [$(status_of "$target")]" >&2

if [ "$follow" = "0" ]; then
  tail -n "$lines" "$target" | shape
  exit 0
fi

if [ "$follow_latest" = "0" ]; then
  tail -n "$lines" -F "$target" | shape
  exit 0
fi

# Follow the newest run or conversation, moving on when a later one appears.
# Each tail is killed only after a successor exists, so no events are dropped in
# between.
#
# Why this is still here rather than retired in favour of the binary, checked on
# 2026-08-31: `yoyo status` cannot follow anything at all, let alone follow the
# latest. The fold that was to give it `--follow` (yoyodyne-ifd.63) did not land
# -- the item is blocked, having been stopped after its permitted repair
# attempts, and its branch is not an ancestor of this one. `yoyo status` takes
# `--config`, `--failed`, `--limit`, and `--json` and nothing else, and its own
# source still refers a reader here to follow a live run. So there is nowhere to
# send this capability, and the fix for an interrupted `-L` printing on is the
# one below. Retiring `-L` becomes the right change on the day the fold lands,
# and not before.
follow_pgid=""

# Start printing the current target in the background, so a later run can be
# watched for while it prints.
#
# Job control is turned on just long enough to start it, which is what gives the
# pipeline a process group of its own, and that group is the handle on the whole
# of it. Two things need that handle. A pipeline started in the background of a
# shell without job control ignores an interrupt, so control-c used to end this
# script and leave the tail printing to the operator's terminal; and the pid
# bash reports for a pipeline is its last command, so killing that alone would
# leave the tail alive until the file it follows grows again, which for a run
# that has finished is never.
#
# Monitor mode is turned back off immediately: the group is fixed when the
# processes are forked and outlives the setting, and leaving it on would have
# bash announce each job's death on a terminal this is trying to leave quiet.
start_follow() {
  set -m
  tail -n "$lines" -F "$target" | shape &
  follow_pgid="$(jobs -p %+)"
  set +m
}

# Stop whatever is printing, if anything still is.
stop_follow() {
  [ -n "$follow_pgid" ] || return 0
  kill -- -"$follow_pgid" 2>/dev/null || true
  wait 2>/dev/null || true
  follow_pgid=""
}

# Control-c, a plain kill, and a closed terminal all mean stop printing, and
# none of them leaves the pipeline behind. The exit status is the conventional
# one for the signal, so whatever started this can still tell an interrupt from
# a failure.
#
# Installing an EXIT handler replaces any earlier one, and there is no earlier
# one to replace: the only other trap in this file is the RETURN trap inside
# cost_report that removes that report's two temporary files, and a RETURN trap
# on a function is a different trap from EXIT and is not touched by these. Nor
# could the two ever both be live -- the cost report exits the script when it is
# done, well above here, so a run that reaches this line never ran cost_report
# and has no temporary files to leave behind. Anything added above that does
# want an EXIT trap has to be composed with this one rather than set beside it.
trap 'stop_follow; exit 130' INT
trap 'stop_follow; exit 143' TERM
trap 'stop_follow; exit 129' HUP
trap 'stop_follow' EXIT

while :; do
  start_follow
  while :; do
    sleep 3
    current="$(newest)"
    if [ -n "$current" ] && [ "$current" != "$target" ]; then
      stop_follow
      target="$current"
      echo "==> $(basename "$target" .events.jsonl) [$(status_of "$target")]" >&2
      break
    fi
    # Any process still in the group means it is still printing. When none is,
    # the pipeline died on its own and the outer loop starts another.
    kill -0 -- -"$follow_pgid" 2>/dev/null || break
  done
done
